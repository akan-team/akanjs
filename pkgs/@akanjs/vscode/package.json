{
  "name": "@akanjs/vscode",
  "displayName": "Akan.js",
  "description": "Go from Akan.js derived names (initMemoInPublic, listByName, setNameOnMemo, srv.memo) to the slice, query, field or class that produces them, see where each source key is used, run akan verify and workflows, and open Akan Studio from the editor.",
  "version": "0.1.0",
  "private": true,
  "publisher": "akanjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akan-team/akanjs.git",
    "directory": "pkgs/@akanjs/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/akan.config.ts"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the extension uses its bundled language core instead of loading the workspace's @akanjs/language, and its verify, workflow and Studio commands, which run the workspace's akan CLI, are off."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "akan.reindex",
        "title": "%akan.reindex.title%",
        "category": "Akan"
      },
      {
        "command": "akan.renameSourceKey",
        "title": "%akan.renameSourceKey.title%",
        "category": "Akan"
      },
      {
        "command": "akan.verify",
        "title": "%akan.verify.title%",
        "category": "Akan",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "akan.runWorkflow",
        "title": "%akan.runWorkflow.title%",
        "category": "Akan",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "akan.createModule",
        "title": "%akan.createModule.title%",
        "category": "Akan",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "akan.addField",
        "title": "%akan.addField.title%",
        "category": "Akan",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "akan.openStudio",
        "title": "%akan.openStudio.title%",
        "category": "Akan",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "akan.openChangeMap",
        "title": "%akan.openChangeMap.title%",
        "category": "Akan",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "akan.openModule",
        "title": "%akan.openModule.title%",
        "category": "Akan"
      }
    ],
    "configuration": {
      "title": "Akan.js",
      "properties": {
        "akan.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%akan.codeLens.enabled.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "akan.renameSourceKey",
        "key": "f2",
        "when": "editorTextFocus && !editorReadonly && akan.onRenameableKey"
      }
    ]
  },
  "dependencies": {
    "@akanjs/language": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.100.0"
  }
}
