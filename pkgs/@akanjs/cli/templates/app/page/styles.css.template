@import "tailwindcss";
@import "akanjs/ui/styles.css";

:root,
[data-theme="dark"] {
  --background: #0a0a0a;
  --foreground: #fafafa;
  --primary: #fafafa;
  --primary-foreground: #171717;
  --secondary: #262626;
  --secondary-foreground: #fafafa;
  --accent: #262626;
  --accent-foreground: #fafafa;
  --neutral: #262626;
  --neutral-foreground: #fafafa;
  --info: #3b82f6;
  --info-foreground: #ffffff;
  --success: #22c55e;
  --success-foreground: #052e16;
  --warning: #f59e0b;
  --warning-foreground: #1a1a1a;
  --destructive: #ef4444;
  --destructive-foreground: #fafafa;
  --open: #22c55e;
  --open-foreground: #052e16;
  --muted: #262626;
  --muted-foreground: #a3a3a3;
  --card: #171717;
  --card-foreground: #fafafa;
  --popover: #171717;
  --popover-foreground: #fafafa;
  --border: #262626;
  --input: #262626;
  --ring: #d4d4d4;
}

[data-theme="light"] {
  --background: #ffffff;
  --foreground: #0a0a0a;
  --primary: #171717;
  --primary-foreground: #fafafa;
  --secondary: #f5f5f5;
  --secondary-foreground: #171717;
  --accent: #f5f5f5;
  --accent-foreground: #171717;
  --neutral: #f5f5f5;
  --neutral-foreground: #171717;
  --info: #2563eb;
  --info-foreground: #ffffff;
  --success: #16a34a;
  --success-foreground: #ffffff;
  --warning: #d97706;
  --warning-foreground: #ffffff;
  --destructive: #dc2626;
  --destructive-foreground: #fafafa;
  --open: #16a34a;
  --open-foreground: #ffffff;
  --muted: #f5f5f5;
  --muted-foreground: #737373;
  --card: #ffffff;
  --card-foreground: #0a0a0a;
  --popover: #ffffff;
  --popover-foreground: #0a0a0a;
  --border: #e5e5e5;
  --input: #e5e5e5;
  --ring: #0a0a0a;
}

/* Typography: Pretendard, the layout's default font, at -3% tracking. Font sizes are even and at least 12px —
   Tailwind's steps from text-xs (12px) to text-9xl (128px) all are, so an arbitrary text-[…] keeps the same rule.
   Text that may wrap takes 150% leading, every size's default; a single line takes the font's own (leading-auto). */
@theme {
  --leading-auto: normal;
  --text-xs--line-height: 1.5;
  --text-xs--letter-spacing: -0.03em;
  --text-sm--line-height: 1.5;
  --text-sm--letter-spacing: -0.03em;
  --text-base--line-height: 1.5;
  --text-base--letter-spacing: -0.03em;
  --text-lg--line-height: 1.5;
  --text-lg--letter-spacing: -0.03em;
  --text-xl--line-height: 1.5;
  --text-xl--letter-spacing: -0.03em;
  --text-2xl--line-height: 1.5;
  --text-2xl--letter-spacing: -0.03em;
  --text-3xl--line-height: 1.5;
  --text-3xl--letter-spacing: -0.03em;
  --text-4xl--line-height: 1.5;
  --text-4xl--letter-spacing: -0.03em;
  --text-5xl--line-height: 1.5;
  --text-5xl--letter-spacing: -0.03em;
  --text-6xl--line-height: 1.5;
  --text-6xl--letter-spacing: -0.03em;
  --text-7xl--line-height: 1.5;
  --text-7xl--letter-spacing: -0.03em;
  --text-8xl--line-height: 1.5;
  --text-8xl--letter-spacing: -0.03em;
  --text-9xl--line-height: 1.5;
  --text-9xl--letter-spacing: -0.03em;
}

/* letter-spacing inherits as a length, not a ratio: text sized without a text-* class keeps -3% of the root's 16px. */
@layer base {
  html {
    letter-spacing: -0.03em;
  }
}
