{
  "name": "@akanjs/cli",
  "version": "3.3.0",
  "sourceType": "module",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "The akan command of Akan.js: create, sync, verify, build, start and deploy an Akan.js workspace. Create one with: bunx create-akan-workspace@latest",
  "homepage": "https://akanjs.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akan-team/akanjs.git",
    "directory": "pkgs/@akanjs/cli"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "akan": "./index.ts"
  },
  "exports": {
    ".": {
      "import": "./index.ts",
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@tailwindcss/node": "^4.3.3",
    "akanjs": "3.3.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "fontaine": "^1.0.1",
    "fonteditor-core": "^2.6.3",
    "ignore": "^7.0.12",
    "ink": "^6.8.0",
    "ora": "^9.4.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "subset-font": "^2.9.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@akanjs/code": "^3.2.0",
    "ssh2": "^1.17.0"
  },
  "peerDependenciesMeta": {
    "@akanjs/code": {
      "optional": true
    },
    "ssh2": {
      "optional": true
    }
  },
  "devDependencies": {},
  "bun": {
    "platform": "bun"
  }
}
