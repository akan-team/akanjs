engine biome(1.0)
language js(typescript, jsx)

// No rewrite: one node's rewrite cannot rename every reference, skip a taken name, or leave a `#field` alone, so
// `akan verify` renames a class's `#method`s and their calls in one pass instead (cli verifyPrivateMethods.ts).
// A call is matched by its callee, so `this.#cache.get()` on a `#private` field is not a private method call.
or {
  JsMethodClassMember() as $method where {
    $method <: contains JsPrivateClassMemberName(),
    register_diagnostic(
      span = $method,
      message = "A `#private` method breaks once this class is mixed into another. Use a TypeScript `private` method, `private name()` called as `this.name()`; `akan verify` renames it unless the class already has that name.",
      severity = "error"
    )
  },
  JsCallExpression(callee = JsStaticMemberExpression(member = JsPrivateName())) as $call where {
    register_diagnostic(
      span = $call,
      message = "A call to a `#private` method: call the TypeScript `private` method that replaces it, `this.name()`.",
      severity = "error"
    )
  }
}
