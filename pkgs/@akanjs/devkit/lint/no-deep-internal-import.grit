engine biome(1.0)
language js(typescript, jsx)

or {
  JsModuleSource() as $source where {
    $source <: within JsImport(),
    not $filename <: r".*\.(?:test|spec)\.tsx?",
    $source <: r"\"@(?:apps|libs)/[^/]+/[^/]+/.+\"",
    not $source <: r"\"@apps/[^/]+/env/env\.(?:client|server)\"",
    register_diagnostic(
      span = $source,
      message = "@apps and @libs imports should only reference the first two path segments after the alias."
    )
  },
  JsModuleSource() as $source where {
    $source <: within JsImport(),
    not $filename <: r".*\.(?:test|spec)\.tsx?",
    $filename <: r".*(?:apps|libs)/[^/]+/lib/[^/]+/[^/]+\.(?:ts|tsx)",
    $source <: r"\"\.\./\.\./.*\"",
    register_diagnostic(
      span = $source,
      message = "Module files should not import from two or more parent directories."
    )
  }
}
