{
  "id": "app",
  "apiVersion": 1,
  "methods": ["getInfo", "getLaunchUrl", "exit", "relaunch", "minimize", "answerBeforeQuit", "setBackEnabled"],
  "events": ["urlOpen", "backButton", "beforeQuit", "backProgress", "serverState"],
  "codegen": true,
  "web": "./src/web.ts",
  "desktop": "./src/desktop.ts",
  "ios": {
    "sources": ["ios/*.swift"],
    "class": "AppPlugin",
    "methods": ["getInfo", "getLaunchUrl", "exit", "minimize"],
    "events": ["urlOpen", "backButton"]
  },
  "android": {
    "sources": ["android/*.kt"],
    "class": "com.akanjs.plugins.app.AppPlugin",
    "methods": ["getInfo", "getLaunchUrl", "exit", "relaunch", "minimize", "setBackEnabled"],
    "events": ["urlOpen", "backButton", "backProgress"]
  }
}
