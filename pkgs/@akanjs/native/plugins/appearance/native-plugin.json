{
  "id": "appearance",
  "apiVersion": 1,
  "methods": ["get", "set", "setThemeColor"],
  "events": ["change"],
  "codegen": true,
  "web": "./src/web.ts",
  "desktop": { "module": "./src/desktop.ts", "methods": ["get", "set"] },
  "ios": {
    "sources": ["ios/*.swift"],
    "class": "AppearancePlugin",
    "privacyApis": { "UserDefaults": ["CA92.1"] }
  },
  "android": {
    "sources": ["android/*.kt"],
    "class": "com.akanjs.plugins.appearance.AppearancePlugin"
  }
}
