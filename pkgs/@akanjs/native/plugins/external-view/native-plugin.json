{
  "id": "external-view",
  "apiVersion": 1,
  "methods": [
    "open",
    "navigate",
    "reload",
    "close",
    "list",
    "setVisible",
    "setBounds",
    "evaluate",
    "sendKey",
    "setMuted",
    "clearData",
    "capture"
  ],
  "events": ["load", "loadFailed", "gone", "consoleMessage"],
  "defaultPermissions": [
    "allow-open",
    "allow-navigate",
    "allow-reload",
    "allow-close",
    "allow-list",
    "allow-setVisible",
    "allow-setBounds",
    "allow-setMuted",
    "allow-clearData",
    "allow-capture",
    "allow-listen-load",
    "allow-listen-loadFailed",
    "allow-listen-gone",
    "allow-listen-consoleMessage"
  ],
  "scope": {
    "description": "Which origins open may give a view: its allowOrigins must each be one of them. The shell checks it.",
    "fields": {
      "origin": "an exact origin, scheme://host[:port] with no path, compared after URL parsing (punycode host, no trailing dot, no default port); no wildcards"
    },
    "required": true
  },
  "defaultScope": {
    "allow": []
  },
  "web": null,
  "desktop": {
    "module": "./src/desktop.ts",
    "unsupported": { "macos": ["sendKey", "setMuted", "capture"] }
  },
  "ios": null,
  "android": null
}
