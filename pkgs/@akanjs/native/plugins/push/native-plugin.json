{
  "id": "push",
  "apiVersion": 1,
  "methods": ["checkPermission", "requestPermission", "register", "unregister", "setForegroundPresentation"],
  "events": ["token", "received", "action"],
  "codegen": true,
  "web": null,
  "desktop": null,
  "ios": {
    "sources": ["ios/*.swift"],
    "class": "PushPlugin",
    "frameworks": ["UserNotifications"],
    "infoPlist": { "UIBackgroundModes": ["remote-notification"] },
    "entitlements": { "aps-environment": "development" }
  },
  "android": {
    "sources": ["android/*.kt"],
    "class": "com.akanjs.plugins.push.PushPlugin",
    "maven": ["com.google.firebase:firebase-messaging:25.1.3", "androidx.core:core:1.10.0"],
    "permissions": ["android.permission.POST_NOTIFICATIONS"],
    "applicationXml": "<service android:name=\"com.akanjs.plugins.push.AkanNativeMessagingService\" android:exported=\"false\"><intent-filter><action android:name=\"com.google.firebase.MESSAGING_EVENT\" /></intent-filter></service>"
  }
}
