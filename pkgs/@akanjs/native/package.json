{
  "name": "@akanjs/native",
  "version": "0.1.0",
  "description": "The native runtime of akanjs: iOS, Android and desktop shells, the bridge, plugins and the build tools that turn a CSR bundle into apps.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    "./core": "./packages/core/src/index.ts",
    "./core/protocol": "./packages/core/src/protocol.ts",
    "./core/kernel": "./packages/core/src/kernel.ts",
    "./core/contract": "./packages/core/src/contract.ts",
    "./core/testing": "./packages/core/src/testing.ts",
    "./react": "./packages/react/src/index.ts",
    "./desktop": "./packages/desktop/src/plugin.ts",
    "./desktop/dispatcher": "./packages/desktop/src/dispatcher.ts",
    "./desktop/delta": "./packages/desktop/src/delta.ts",
    "./config": "./packages/cli/src/config.ts",
    "./api": "./packages/cli/src/api.ts",
    "./plugins/*": "./plugins/*/src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "akan-native": "bun packages/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
