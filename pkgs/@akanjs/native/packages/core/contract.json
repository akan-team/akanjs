{
  "about": "Tables and constants every akan-native host shares (docs/architecture.md §5). scripts/contract.ts writes them into packages/core/src/contract.ts, native/desktop/src/contract.rs, native/ios/Sources/AkanNativeContract.swift and native/android/src/com/akanjs/runtime/AkanNativeContract.kt; bun test fails when those are stale. Algorithms are not generated: each language implements them and must pass packages/core/vectors.",
  "errorCodes": ["UNSUPPORTED", "PERMISSION_DENIED", "CANCELLED", "TIMEOUT", "INVALID_ARGS", "NOT_FOUND", "NOT_ALLOWED", "INTERNAL"],
  "mime": {
    "html": "text/html",
    "htm": "text/html",
    "js": "text/javascript",
    "mjs": "text/javascript",
    "css": "text/css",
    "json": "application/json",
    "map": "application/json",
    "webmanifest": "application/manifest+json",
    "txt": "text/plain",
    "text": "text/plain",
    "log": "text/plain",
    "md": "text/markdown",
    "csv": "text/csv",
    "tsv": "text/tab-separated-values",
    "xml": "application/xml",
    "yaml": "application/yaml",
    "yml": "application/yaml",
    "ics": "text/calendar",
    "vcf": "text/vcard",
    "pdf": "application/pdf",
    "rtf": "application/rtf",
    "zip": "application/zip",
    "gz": "application/gzip",
    "tar": "application/x-tar",
    "wasm": "application/wasm",
    "epub": "application/epub+zip",
    "doc": "application/msword",
    "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "xls": "application/vnd.ms-excel",
    "xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "ppt": "application/vnd.ms-powerpoint",
    "pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
    "png": "image/png",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "gif": "image/gif",
    "webp": "image/webp",
    "avif": "image/avif",
    "heic": "image/heic",
    "heif": "image/heif",
    "bmp": "image/bmp",
    "svg": "image/svg+xml",
    "ico": "image/x-icon",
    "tif": "image/tiff",
    "tiff": "image/tiff",
    "mp3": "audio/mpeg",
    "m4a": "audio/mp4",
    "aac": "audio/aac",
    "wav": "audio/wav",
    "ogg": "audio/ogg",
    "flac": "audio/flac",
    "mp4": "video/mp4",
    "m4v": "video/mp4",
    "mov": "video/quicktime",
    "webm": "video/webm",
    "ttf": "font/ttf",
    "otf": "font/otf",
    "woff": "font/woff",
    "woff2": "font/woff2",
    "glb": "model/gltf-binary",
    "gltf": "model/gltf+json"
  },
  "mimeUtf8": {
    "about": "Assets of these types are served with charset=utf-8: every text/* type, and these.",
    "types": ["application/json", "application/manifest+json", "application/xml", "application/yaml", "image/svg+xml", "model/gltf+json"]
  },
  "ids": {
    "about": "Characters, lengths and extensions of the ids hosts accept. Lengths count ASCII characters.",
    "fileRef": { "chars": "A-Za-z0-9_-", "min": 1, "max": 128, "extChars": "A-Za-z0-9", "extMax": 8 },
    "bundle": { "chars": "A-Za-z0-9_.-", "min": 1, "max": 80, "notFirst": "." },
    "document": { "chars": "A-Za-z0-9_-", "min": 8, "max": 64 },
    "name": { "first": "$A-Za-z", "chars": "A-Za-z0-9_.-", "min": 1, "max": 64 }
  },
  "schemes": {
    "external": ["http", "https", "mailto", "tel"],
    "frames": ["http", "https", "data", "blob", "about"],
    "neverExternal": ["javascript", "vbscript", "file", "data", "blob", "about", "content", "intent", "app"],
    "about": "external: what the shell may hand to the OS (links, window.open, opener); the app may add schemes (security.shell.externalSchemes) except neverExternal. frames: what an iframe may load."
  },
  "routes": {
    "root": "__akan_native",
    "init": "init.js",
    "ipc": "ipc",
    "hello": "hello",
    "file": "file"
  },
  "initPrefix": "window.__AKAN_NATIVE__=(function(o,b,e){for(var k in b)o[k]=b[k];o.env=e;return o})(window.__AKAN_NATIVE__||{},",
  "initSuffix": ");\n",
  "maxRangeBytes": 1024000,
  "externalOpensPerSecond": 1,
  "maxRetainedEvents": 16
}
