      "acl": {
        "grants": [
          { "plugin": "fs", "windows": "*", "items": ["readFile", "stat"] },
          { "plugin": "fs", "windows": [1], "items": ["writeFile"], "allow": [{ "base": "data", "path": "notes/**" }], "deny": [{ "path": "notes/secret/**" }] },
          { "plugin": "fs", "windows": [2], "items": ["writeFile"], "allow": [{ "base": "cache", "path": "**" }] },
          { "plugin": "fs", "windows": "*", "items": ["remove"], "deny": [{ "path": "keep/**" }] },
          { "plugin": "win", "windows": "*", "items": "*" }
        ],
        "denied": { "win": ["close"], "fs": ["listen:change"] }
      },
      "problem": false,
      "checks": [
        ["fs", "readFile", 1, true, null],
        ["fs", "readFile", 3, true, null],
        ["fs", "writeFile", 1, true, { "allow": [{ "base": "data", "path": "notes/**" }], "deny": [{ "path": "notes/secret/**" }] }],
        ["fs", "writeFile", 2, true, { "allow": [{ "base": "cache", "path": "**" }], "deny": [] }],
        ["fs", "writeFile", 3, false, null],
        ["fs", "remove", 1, true, { "allow": null, "deny": [{ "path": "keep/**" }] }],
        ["fs", "listen:change", 1, false, null],
        ["fs", "mkdir", 1, false, null],
        ["win", "setTitle", 5, true, null],
        ["win", "close", 1, false, null],
        ["other", "x", 1, false, null]
      ]
    },
