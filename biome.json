{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "extends": ["@akanjs/devkit/biome.base.json"],
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "!infra/master/createRecords.ts",
      "!pkgs/@akanjs/devkit/lint/__fixtures__",
      "!!.claude",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.akan",
      "!!**/dump",
      "!!**/local",
      "!!**/ios/DerivedData",
      "!!pkgs/@akanjs/native/native/android/maven.lock.json",
      "!!pkgs/@akanjs/native/packages/core/contract.json",
      "!!pkgs/@akanjs/native/packages/core/src/contract.ts",
      "!!pkgs/@akanjs/native/packages/core/vectors",
      "!benchmarks/sample-app-productivity/tmp",
      "!benchmarks/sample-app-productivity/workspaces"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noExtraBooleanCast": "error",
        "noUselessFragments": "error",
        "useArrayFind": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "error",
        "useOptionalChain": "error"
      },
      "correctness": {
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noConfusingVoidType": "error",
        "noFocusedTests": "error",
        "noTemplateCurlyInString": "error",
        "useArraySortCompare": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "pkgs/akanjs/**/*.ts",
        "pkgs/akanjs/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/*.spec.tsx"
      ],
      "plugins": [
        "./node_modules/@akanjs/devkit/lint/no-raw-palette-class.grit",
        "./node_modules/@akanjs/devkit/lint/no-arbitrary-color.grit",
        "./node_modules/@akanjs/devkit/lint/no-daisyui-legacy-class.grit",
        "./node_modules/@akanjs/devkit/lint/no-inline-color.grit",
        "./node_modules/@akanjs/devkit/lint/no-interpolated-arbitrary-class.grit",
        "./node_modules/@akanjs/devkit/lint/no-deprecated-log-level.grit"
      ]
    }
  ]
}
