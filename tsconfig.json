{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "esnext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "experimentalDecorators": true,
    "paths": {
      "@apps/*": ["./apps/*"],
      "@libs/*": ["./libs/*"],
      "akanjs": ["./pkgs/akanjs/index.ts"],
      "akanjs/*": ["./pkgs/akanjs/*"],
      "akanjs/base": ["./pkgs/akanjs/base/index.ts"],
      "akanjs/base/*": ["./pkgs/akanjs/base/*"],
      "akanjs/client": ["./pkgs/akanjs/client/index.ts"],
      "akanjs/client/*": ["./pkgs/akanjs/client/*"],
      "akanjs/common": ["./pkgs/akanjs/common/index.ts"],
      "akanjs/common/*": ["./pkgs/akanjs/common/*"],
      "akanjs/constant": ["./pkgs/akanjs/constant/index.ts"],
      "akanjs/constant/*": ["./pkgs/akanjs/constant/*"],
      "akanjs/dictionary": ["./pkgs/akanjs/dictionary/index.ts"],
      "akanjs/dictionary/*": ["./pkgs/akanjs/dictionary/*"],
      "akanjs/document": ["./pkgs/akanjs/document/index.ts"],
      "akanjs/document/*": ["./pkgs/akanjs/document/*"],
      "akanjs/fetch": ["./pkgs/akanjs/fetch/index.ts"],
      "akanjs/fetch/*": ["./pkgs/akanjs/fetch/*"],
      "akanjs/webkit": ["./pkgs/akanjs/webkit/index.ts"],
      "akanjs/webkit/*": ["./pkgs/akanjs/webkit/*"],
      "akanjs/server": ["./pkgs/akanjs/server/index.ts"],
      "akanjs/server/*": ["./pkgs/akanjs/server/*"],
      "akanjs/service": ["./pkgs/akanjs/service/index.ts"],
      "akanjs/service/*": ["./pkgs/akanjs/service/*"],
      "akanjs/signal": ["./pkgs/akanjs/signal/index.ts"],
      "akanjs/signal/*": ["./pkgs/akanjs/signal/*"],
      "akanjs/store": ["./pkgs/akanjs/store/index.ts"],
      "akanjs/store/*": ["./pkgs/akanjs/store/*"],
      "akanjs/test": ["./pkgs/akanjs/test/index.ts"],
      "akanjs/test/*": ["./pkgs/akanjs/test/*"],
      "akanjs/ui": ["./pkgs/akanjs/ui/index.ts"],
      "akanjs/ui/*": ["./pkgs/akanjs/ui/*"],
      "@akanjs/cli": ["./pkgs/@akanjs/cli/index.ts"],
      "@akanjs/cli/*": ["./pkgs/@akanjs/cli/*"],
      "@akanjs/devkit": ["./pkgs/@akanjs/devkit/index.ts"],
      "@akanjs/devkit/*": ["./pkgs/@akanjs/devkit/*"],
      "@akanjs/language": ["./pkgs/@akanjs/language/index.ts"],
      "@akanjs/language/*": ["./pkgs/@akanjs/language/*"]
    }
  }
}
