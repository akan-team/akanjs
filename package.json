  "scripts": {
    "uploadEnv": "chmod +x infra/master/jenkins/uploadEnv.sh && chmod +x infra/master/jenkins/getSecrets.sh && bash infra/master/jenkins/uploadEnv.sh",
    "downloadEnv": "chmod +x infra/master/jenkins/downloadEnv.sh && chmod +x infra/master/jenkins/getSecrets.sh && bash infra/master/jenkins/downloadEnv.sh",
    "registerEnv": "chmod +x infra/master/jenkins/registerEnv.sh && chmod +x infra/master/jenkins/getSecrets.sh && bash infra/master/jenkins/registerEnv.sh",
    "uploadSecret": "chmod +x infra/master/jenkins/uploadSecret.sh && chmod +x infra/master/jenkins/getSecrets.sh && bash infra/master/jenkins/uploadSecret.sh",
    "downloadSecret": "chmod +x infra/master/jenkins/downloadSecret.sh && chmod +x infra/master/jenkins/getSecrets.sh && bash infra/master/jenkins/downloadSecret.sh",
    "registerSecret": "chmod +x infra/master/jenkins/registerSecret.sh && chmod +x infra/master/jenkins/getSecrets.sh && bash infra/master/jenkins/registerSecret.sh",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "release:build-packages": "bun pkgs/@akanjs/cli/build.ts && bun dist/pkgs/@akanjs/cli/index.js build-package akanjs && bun dist/pkgs/@akanjs/cli/index.js build-package @akanjs/devkit && bun dist/pkgs/@akanjs/cli/index.js build-package create-akan-workspace && bun dist/pkgs/@akanjs/cli/index.js build-package @akanjs/cli",
    "release:verify-packages": "bun dist/pkgs/@akanjs/cli/index.js verify-akan-publish-packages",
    "release:smoke-registry": "bun run akan reset-registry && bun run akan smoke-registry --test=true --tag=rc --registry=http://127.0.0.1:4873",
    "akan": "bun pkgs/@akanjs/cli/build.ts && bun dist/pkgs/@akanjs/cli/index.js",
    "killAkan": "lsof -ti tcp:8282,18282-18300 | xargs kill -9",
    "buildAkan": "bun pkgs/@akanjs/cli/build.ts",
    "runAkan": "bun dist/pkgs/@akanjs/cli/index.js",
    "create-akan-workspace": "bun pkgs/create-akan-workspace/build.ts && bun dist/pkgs/create-akan-workspace/index.js",
    "pr": "gh pr create --repo akan-team/akanjs --base main --fill"
  },
