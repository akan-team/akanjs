        "@vitejs/plugin-react",
        "vite",
        "react",
        "react-dom",
        "typescript"
      ],
      "promptAppendix": "scenarios/team-task-board/prompt.hono-drizzle.md",
      "setup": [
        {
          "cmd": "bunx",
          "args": [
            "create-vite@latest",
            "{{workspacePath}}",
            "--template",
            "react-ts"
          ]
        },
        {
          "cmd": "bun",
          "args": [
            "add",
            "hono",
            "drizzle-orm"
          ],
          "cwd": "{{workspacePath}}"
        },
        {
          "cmd": "bun",
          "args": [
            "add",
            "-d",
            "drizzle-kit"
          ],
          "cwd": "{{workspacePath}}"
        }
      ],
      "installCommand": [
        "bun",
        "install"
      ],
      "baseUrl": "http://127.0.0.1:5173",
      "startCommand": [
        "bun",
        "run",
        "dev",
        "--host",
        "127.0.0.1"
      ],
      "buildCommand": [
        "bun",
        "run",
        "build"
      ],
      "lintCommand": null,
      "conventionCheck": null,
      "versionChecks": []
    },
