{
  "exclude": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".next/**",
    ".vite/**",
    ".akan/**",
    "coverage/**",
    "*.db",
    "*.db-*",
    "*.sqlite",
    "*.sqlite-*"
  ],
  "generatedOrLock": [
    "bun.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "*.lock",
    "**/generated/**",
    "**/__generated__/**",
    "**/index.generated.*",
    "**/prisma/migrations/**",
    "apps/*/lib/cnst.ts",
    "apps/*/lib/db.ts",
    "apps/*/lib/sig.ts",
    "apps/*/lib/srv.ts",
    "apps/*/lib/st.ts",
    "apps/*/lib/useClient.ts",
    "apps/*/lib/useServer.ts"
  ],
  "test": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "tests/**",
    "e2e/**",
    "playwright/**"
  ],
  "glue": [
    "**/api/**",
    "**/routes/**",
    "**/server/**",
    "**/api.ts",
    "**/routes.ts",
    "**/server.ts",
    "**/prisma/**",
    "**/drizzle/**",
    "**/schema.ts",
    "**/schema.prisma",
    "**/schema/*.ts",
    "**/db.ts",
    "**/database.ts",
    "**/client.ts",
    "**/fetch.ts",
    "**/auth.ts",
    "**/session.ts",
    "**/middleware.ts",
    "**/next.config.*",
    "**/vite.config.*",
    "**/drizzle.config.*",
    "**/prisma.config.*",
    "**/akan.config.ts"
  ],
  "appSource": [
    "app/**",
    "src/**",
    "pages/**",
    "components/**",
    "lib/**",
    "apps/*/page/**",
    "apps/*/lib/**"
  ]
}
