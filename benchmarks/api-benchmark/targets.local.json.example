{
  "__doc__": [
    "Copy this file to targets.local.json (gitignored) to override target definitions for your",
    "machine or app. Values are shallow-merged onto the built-in TARGETS, so any object field you",
    "include (e.g. 'paths') REPLACES the whole default object - copy it in full when overriding.",
    "",
    "The built-in akan-single/akan-cluster defaults already target the shared `user` model + `admin`",
    "auth on the `minimal` app and work out of the box. You only need this file to point the harness",
    "at a different app, port, model prefix, or admin credentials.",
    "",
    "Most common knobs are environment variables instead (no file needed):",
    "  BENCH_AKAN_APP=<appName>            which app `bun run akan start` boots (default: minimal)",
    "  BENCH_AKAN_PORT=<port>              override the local dev port when another app is already using it",
    "  BENCH_AKAN_ADMIN_ACCOUNT_ID=<email> admin login id (default: bench-admin@akanjs.com)",
    "  BENCH_AKAN_ADMIN_PASSWORD=<pw>      admin login password (default: benchadmin1234)",
    "  BENCH_AKAN_SEED=<n>                 documents to seed before scenarios (default: 10000)",
    "  BENCH_TOKEN=<jwt>                   skip login entirely and use this bearer token"
  ],
  "akan-single": {
    "name": "akan-single",
    "label": "akanjs (single / SQLite)",
    "runtime": "bun",
    "runtimeLabel": "bun",
    "cmd": ["bun", "run", "akan", "start", "minimal"],
    "env": {
      "AKAN_PUBLIC_OPERATION_MODE": "local",
      "SERVER_MODE": "all",
      "AKAN_PUBLIC_LOG_LEVEL": "warn",
      "AKAN_LOG_FILE_LEVEL": "warn",
      "AKAN_BENCH_SKIP_REQUEST_ID": "1"
    },
    "port": 8282,
    "baseUrl": "http://127.0.0.1:8282",
    "wsUrl": "ws://127.0.0.1:8282/api/ws",
    "metricsUrl": "http://127.0.0.1:8282/_akan/app/metrics",
    "paths": {
      "pureHttp": "/_akan/bench/ping",
      "signalNoDb": "/api/benchPing",
      "ping": "/api/user/lightUser/{id}",
      "find": "/api/user/user/{id}",
      "list": "/api/user/userList?limit=20&skip=0",
      "relation": "/api/user/user/{id}",
      "create": "/api/user/createUser",
      "login": "/api/admin/signinAdmin"
    },
    "loginCredentials": { "accountId": "bench-admin@akanjs.com", "password": "benchadmin1234" },
    "seed": { "count": 10000, "bodyKey": "data" },
    "surfaces": ["pure_http", "signal", "rest", "db", "websocket", "fullstack", "ssr"]
  }
}
